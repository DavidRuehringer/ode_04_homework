<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<Scene fill="#80220d" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ode_04_homework.PokedexController">
    <AnchorPane prefHeight="200" prefWidth="200" style="-fx-background-color: #82240d;">
      <children>
         <VBox prefHeight="300.0" prefWidth="500.0" style="-fx-background-color: #82240d;">
            <children>
               <TextArea fx:id="log" maxWidth="1.7976931348623157E308" prefHeight="50.0">
                  <VBox.margin>
                     <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                  </VBox.margin>
               </TextArea>
               <HBox spacing="10.0">
                  <children>
                     <VBox prefWidth="300.0" spacing="10.0">
                        <children>
                           <TextField fx:id="name" promptText="Name">
                              <VBox.margin>
                                 <Insets />
                              </VBox.margin>
                           </TextField>
                           <TextField fx:id="level" promptText="Level" />
                           <TextField fx:id="hp" promptText="Health Points" />
                           <TextField fx:id="exp" promptText="Experience" />
                           <Button fx:id="add" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#pokemonAdd" text="Add" textAlignment="CENTER">
                              <VBox.margin>
                                 <Insets />
                              </VBox.margin>
                           </Button>
                           <Button fx:id="remove" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#pokemonRemove" text="Remove" textAlignment="CENTER" />
                           <Button fx:id="clear" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#pokedexClear" text="Clear Pokedex" />
                        </children>
                        <HBox.margin>
                           <Insets />
                        </HBox.margin>
                     </VBox>
                     <ListView fx:id="list_pokedex" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                  </children>


                  <VBox.margin>
                     <Insets bottom="10.0" left="10.0" right="10.0" />
                  </VBox.margin>
               </HBox>
            </children>
         </VBox>
      </children></AnchorPane>
</Scene>
